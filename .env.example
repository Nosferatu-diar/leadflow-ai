# Copy to .env in the project root and supply your real PostgreSQL connection URL.
# Keep credentials private. Do not prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=

# Server-side OpenAI configuration. Never use NEXT_PUBLIC_ for the API key.
OPENAI_API_KEY=
# Optional: defaults to gpt-5.4-nano when empty.
OPENAI_MODEL=

# Server-only Telegram notification credentials. Never use NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
