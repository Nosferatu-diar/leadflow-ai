# Server-only values. Local: .env. Production: Netlify environment settings.
# Required for persistence and admin access.
DATABASE_URL=
ADMIN_EMAIL=
# Preserve single quotes around your generated bcrypt hash in .env.
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
# Required for proxy deployment: exact public HTTPS origin, no path/trailing slash.
# Leave blank for local development to compare against the request URL.
APP_ORIGIN=

# Optional integrations. Missing values do not prevent lead persistence.
OPENAI_API_KEY=
# Optional model override; blank uses the application default.
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: x-real-ip or x-forwarded-for. Only behind an unavoidable trusted
# proxy that overwrites this header with ONE validated client IP (no chain).
# Leave blank if this guarantee has not been configured and verified.
TRUST_PROXY_IP_HEADER=
