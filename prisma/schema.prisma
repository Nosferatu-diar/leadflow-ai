generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactMethod {
  Telegram
  Email
  Phone
}

enum Service {
  Website
  WebApplication @map("Web Application")
  AIAutomation   @map("AI Automation")
  Other
}

enum AIPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model Lead {
  id               String        @id @default(cuid())
  name             String
  contactMethod    ContactMethod
  contact          String
  service          Service
  budget           String?
  message          String?
  status           LeadStatus    @default(NEW)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  aiSummary        String?
  aiPriority       AIPriority?
  aiIntent         String?
  aiSuggestedReply String?
  aiAnalyzedAt     DateTime?     @db.Timestamptz(3)
}
